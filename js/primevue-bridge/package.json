{
	"name": "@gradio/primevue-bridge",
	"version": "0.1.0",
	"description": "Bridge to use PrimeVue components as Web Components inside Svelte",
	"type": "module",
	"private": true,
	"main": "src/index.ts",
	"exports": {
		".": {
			"gradio": "./src/index.ts",
			"import": "./dist/index.js"
		},
		"./components": {
			"gradio": "./src/register.ts",
			"import": "./dist/register.js"
		}
	},
	"dependencies": {
		"vue": "^3.5.0",
		"primevue": "^4.3.0",
		"@primevue/themes": "^4.3.0"
	},
	"peerDependencies": {
		"svelte": "^5.48.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/gradio-app/gradio.git",
		"directory": "js/primevue-bridge"
	}
}
